# PostgreSQL
POSTGRES_DB=therasync
POSTGRES_USER=therasync_user
POSTGRES_PASSWORD=therasync_secret_2026

# Backend
# Comma-separated list of origins allowed to call the API directly
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# Optional: ElevenLabs narration generation for the Remotion demo video.
# Keep the real key in your shell or an ignored local .env file.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_MODEL_ID=eleven_v3
# Eleven v3 uses native, punctuation-led pacing and does not support SPEED.
# ELEVENLABS_SPEED=0.95 # Optional only for a non-v3 model.
